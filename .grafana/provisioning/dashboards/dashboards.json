                        "pluginVersion": "4.17.0",
                        "queryType": "table",
                        "rawSql": "SELECT \r\n    toDayOfWeek(order_date) AS `Номер дня`,\r\n    caseWithExpression(\r\n        toDayOfWeek(order_date), \r\n        1, 'Понедельник', \r\n        2, 'Вторник', \r\n        3, 'Среда', \r\n        4, 'Четверг', \r\n        5, 'Пятница', \r\n        6, 'Суббота', \r\n        7, 'Воскресенье', \r\n        NULL\r\n    ) AS `День недели`, \r\n    toHour(order_date) AS `Час`, \r\n    count(DISTINCT order_id) AS `Количество заказов`, \r\n    round(avg(total_price), 2) AS `Средний чек` \r\nFROM book_shop_analyst.orders_fact \r\nGROUP BY \r\n    `Номер дня`, \r\n    `День недели`, \r\n    `Час` \r\nORDER BY \r\n    `Номер дня` ASC, \r\n    `Час` ASC"
